CREATE TABLE IF NOT EXISTS coordinators (
    id bigserial NOT NULL,
    group_id TEXT NOT NULL,
    user_id TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending'::text,
    name_th TEXT NULL,
    name_en TEXT NULL,
    nickname TEXT NULL,
    job_title TEXT NULL,
    phone TEXT NULL,
    email TEXT NULL,
    relevant TEXT NULL,
    created_at TIMESTAMP WITH TIME ZONE NULL DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE NULL DEFAULT NOW(),
    CONSTRAINT pk_coordinators PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS line_groups (
    group_id TEXT PRIMARY KEY,
    display_name TEXT NULL,
    picture_url TEXT NULL,
    status TEXT NOT NULL DEFAULT 'active'::text,
    first_seen_at TIMESTAMP WITH TIME ZONE NOT NULL,
    joined_at TIMESTAMP WITH TIME ZONE NULL,
    left_at TIMESTAMP WITH TIME ZONE NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW()
);


CREATE TABLE IF NOT EXISTS companies(
    id bigserial NOT NULL,
    group_id text NULL UNIQUE REFERENCES line_groups(group_id) ON DELETE SET NULL,
    company_th text NULL,
    company_en text NULL,
    aliases text[] NULL DEFAULT '{}'::text[],
    is_linked boolean NOT NULL DEFAULT false,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT pk_companies PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS mous (
    id BIGSERIAL PRIMARY KEY,
    company_id BIGINT NOT NULL,
    document_status TEXT NOT NULL CHECK (
        document_status IN (
            'legal_revision_chula',
            'company_legal_review',
            'authorization',
            'pending_signature',
            'signed',
            'signed_with_university',
            'signed_subsidiary',
            'chula_department_review',
            'rejected',
            'unsigned'
        )
    ),
    is_authorized BOOLEAN NOT NULL DEFAULT false,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);


CREATE TABLE IF NOT EXISTS token_logs (
    id SERIAL PRIMARY KEY,
    log_type TEXT NOT NULL,
    step_name TEXT NOT NULL,
    group_id TEXT NULL,
    user_id TEXT NOT NULL,
    input_tokens INTEGER NOT NULL,
    output_tokens INTEGER NOT NULL,
    total_tokens INTEGER NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NULL DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS users (
    id SERIAL PRIMARY KEY,
    username TEXT NOT NULL UNIQUE,
    display_name TEXT NULL,
    password TEXT NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NULL DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE NULL DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS notes (
    id bigserial NOT NULL,
    content text NULL, -- not null
    group_id text NULL,
    person_id integer NULL,
    type text NOT NULL DEFAULT 'mou',
    sentiment text NOT NULL DEFAULT 'neutral',
    source text NOT NULL DEFAULT 'external',
    academic_year integer NULL,
    term integer NULL,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT pk_notes PRIMARY KEY (id)
);

CREATE TABLE chat_histories (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    role TEXT NOT NULL DEFAULT 'user' CHECK (role IN ('user', 'ai')),
    message TEXT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);


CREATE TABLE contacts (
    id BIGSERIAL PRIMARY KEY,
    company_id BIGINT NOT NULL,
    name TEXT NOT NULL,
    nickname TEXT NULL,
    role TEXT NOT NULL DEFAULT 'instructor' CHECK (role IN ('instructor', 'senior', 'alumni', 'insider')),
    status VARCHAR(20) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'resigned', 'transferred', 'inactive')),
    phone VARCHAR(20) NULL,
    email TEXT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    
);


CREATE TABLE IF NOT EXISTS update_logs (
    id bigserial NOT NULL,
    user_id BIGINT NOT NULL,
    error_groups text[] NULL DEFAULT '{}'::text[],
    created_at timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT pk_update_logs PRIMARY KEY (id)
);



-- แนะนำให้สร้าง Index เพิ่มเติมที่ user_id เพื่อให้ Query ดึงประวัติแชทได้เร็วขึ้นเมื่อข้อมูลมีจำนวนมาก
-- CREATE INDEX idx_chat_histories_user_id ON chat_histories(user_id);